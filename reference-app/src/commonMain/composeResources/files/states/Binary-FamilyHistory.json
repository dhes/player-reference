{
  "resourceType": "https://sql-on-fhir.org/ig/StructureDefinition/ViewDefinition",
  "url": "http://ohs.dev/ViewDefinition/FamilyHistory",
  "fhirVersion": [
    "4.0.1"
  ],
  "select": [
    {
      "column": [
        {
          "name": "fmhId",
          "path": "id",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "relationName",
          "path": "relationship.coding.display.first()",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "fmhPatientRef",
          "path": "patient.reference.replace('Patient/', '')",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        }
      ]
    },
    {
      "column": [
        {
          "name": "fmhConditionName",
          "path": "code.coding.display.first()",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "fmhOutcome",
          "path": "outcome.coding.display.first()",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "fmhOnsetAge",
          "path": "onset.value.toString()",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        }
      ],
      "forEach": "condition"
    }
  ],
  "name": "FamilyHistory",
  "status": "active",
  "resource": "FamilyMemberHistory"
}
